# Delta Messaging Platform - Environment Configuration Template
# Copy this file to .env.local and configure your environment variables.

# ---------------------------------------------------------------------------
# SUPABASE CONFIGURATION (REQUIRED FOR PERSISTED PRODUCTION MODE)
# ---------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anonymous Public API Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# APPLICATION SETTINGS & BACKEND PROXY
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Delta
NEXT_PUBLIC_APP_TAGLINE="Everything connects."

# Live Google Cloud Run Backend API URL (Proxies /api/* and /:version/:id/*)
NEXT_PUBLIC_BACKEND_API_URL=https://delta-backend-44277514752.asia-south1.run.app

# Mode: Set to "true" to enable interactive demo preview mode when Supabase is not configured.
# Set to "false" to enforce real Supabase database and authentication.
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# ---------------------------------------------------------------------------
# GOOGLE GEMINI AI CONFIGURATION (FREE TIER)
# ---------------------------------------------------------------------------
# Obtain your free Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSy...

# ---------------------------------------------------------------------------
# WEBRTC CALLING CONFIGURATION (STUN / TURN)
# ---------------------------------------------------------------------------
# Google public STUN servers are used by default for NAT traversal.
# In production across enterprise firewalls, configure your TURN server credentials below:
NEXT_PUBLIC_STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
# TURN_SERVER_URL=turn:turn.yourdomain.com:3478
# TURN_USERNAME=delta_turn_user
# TURN_CREDENTIAL=delta_turn_secret_token

# ---------------------------------------------------------------------------
# SMS / PHONE AUTHENTICATION (OPTIONAL - TWILIO / SUPABASE AUTH PROVIDER)
# ---------------------------------------------------------------------------
# If using Twilio Phone OTP via Supabase Auth, configure directly in the Supabase Dashboard:
# Dashboard > Authentication > Providers > Phone (Enable Twilio / MessageBird)
